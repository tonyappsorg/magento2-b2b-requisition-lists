<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="tonyapps_b2b_requisition_list" resource="default" engine="innodb" comment="B2B Requisition Lists">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="List ID"/>
        <column xsi:type="int" name="company_id" unsigned="true" nullable="false" comment="Owning Company ID"/>
        <column xsi:type="int" name="created_by_customer_id" unsigned="true" nullable="true" comment="Creator Customer ID"/>
        <column xsi:type="varchar" name="name" length="100" nullable="false" comment="List Name"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY"><column name="entity_id"/></constraint>
        <constraint xsi:type="foreign" referenceId="TONYAPPS_B2B_REQ_LIST_COMPANY_ID_COMPANY_ENTITY_ID" table="tonyapps_b2b_requisition_list" column="company_id" referenceTable="tonyapps_b2b_company" referenceColumn="entity_id" onDelete="CASCADE"/>
        <constraint xsi:type="foreign" referenceId="TONYAPPS_B2B_REQ_LIST_CREATOR_CUSTOMER_ID_CUSTOMER_ENTITY_ID" table="tonyapps_b2b_requisition_list" column="created_by_customer_id" referenceTable="customer_entity" referenceColumn="entity_id" onDelete="SET NULL"/>
        <constraint xsi:type="unique" referenceId="TONYAPPS_B2B_REQ_LIST_COMPANY_NAME"><column name="company_id"/><column name="name"/></constraint>
        <index referenceId="TONYAPPS_B2B_REQ_LIST_COMPANY" indexType="btree"><column name="company_id"/></index>
    </table>
    <table name="tonyapps_b2b_requisition_list_item" resource="default" engine="innodb" comment="B2B Requisition List Items">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Item ID"/>
        <column xsi:type="int" name="list_id" unsigned="true" nullable="false" comment="List ID"/>
        <column xsi:type="varchar" name="sku" length="64" nullable="false" comment="Product SKU"/>
        <column xsi:type="decimal" name="qty" precision="12" scale="4" unsigned="true" nullable="false" comment="Requested Quantity"/>
        <constraint xsi:type="primary" referenceId="PRIMARY"><column name="entity_id"/></constraint>
        <constraint xsi:type="foreign" referenceId="TONYAPPS_B2B_REQ_ITEM_LIST_ID_LIST_ID" table="tonyapps_b2b_requisition_list_item" column="list_id" referenceTable="tonyapps_b2b_requisition_list" referenceColumn="entity_id" onDelete="CASCADE"/>
        <constraint xsi:type="unique" referenceId="TONYAPPS_B2B_REQ_ITEM_LIST_SKU"><column name="list_id"/><column name="sku"/></constraint>
        <index referenceId="TONYAPPS_B2B_REQ_ITEM_LIST" indexType="btree"><column name="list_id"/></index>
    </table>
</schema>
