<?php
/** @var \Tonyapps\B2bRequisitionLists\Block\List\Index $block */
/** @var \Magento\Framework\Escaper $escaper */
$canManage = $block->canManage();
$lists = $block->getLists();
?>
<div class="b2b-requisition-lists">
    <p><?= $escaper->escapeHtml(__('Lists are shared with members of your company. Enter one SKU and quantity per row, separated by a comma.')) ?></p>
    <?php if ($canManage): ?>
        <section class="block block-requisition-list-create">
            <div class="block-title"><strong><?= $escaper->escapeHtml(__('Create a Requisition List')) ?></strong></div>
            <form action="<?= $escaper->escapeUrl($block->getUrl('b2brequisitionlists/list/save')) ?>" method="post">
                <?= $block->getBlockHtml('formkey') ?>
                <div class="field required"><label class="label" for="new-list-name"><span><?= $escaper->escapeHtml(__('List Name')) ?></span></label><div class="control"><input class="input-text" id="new-list-name" type="text" name="name" maxlength="100" required/></div></div>
                <div class="field"><label class="label" for="new-list-items"><span><?= $escaper->escapeHtml(__('SKUs and Quantities')) ?></span></label><div class="control"><textarea id="new-list-items" name="items" rows="4" placeholder="SKU-1001, 2&#10;SKU-1002, 1"></textarea></div></div>
                <button type="submit" class="action primary"><span><?= $escaper->escapeHtml(__('Create List')) ?></span></button>
            </form>
        </section>
    <?php endif; ?>
    <?php foreach ($lists as $list): ?>
        <section class="block block-requisition-list">
            <div class="block-title"><strong><?= $escaper->escapeHtml($list['name']) ?></strong></div>
            <?php if ($canManage): ?>
                <form action="<?= $escaper->escapeUrl($block->getUrl('b2brequisitionlists/list/save')) ?>" method="post">
                    <?= $block->getBlockHtml('formkey') ?>
                    <input type="hidden" name="list_id" value="<?= (int) $list['entity_id'] ?>"/>
                    <div class="field required"><label class="label"><span><?= $escaper->escapeHtml(__('List Name')) ?></span></label><div class="control"><input class="input-text" type="text" name="name" maxlength="100" value="<?= $escaper->escapeHtmlAttr($list['name']) ?>" required/></div></div>
                    <div class="field"><label class="label"><span><?= $escaper->escapeHtml(__('SKUs and Quantities')) ?></span></label><div class="control"><textarea name="items" rows="4"><?php foreach ($list['items'] as $item): ?><?= $escaper->escapeHtml($item['sku'] . ', ' . $item['qty']) ?>&#10;<?php endforeach; ?></textarea></div></div>
                    <button type="submit" class="action primary"><span><?= $escaper->escapeHtml(__('Save Changes')) ?></span></button>
                </form>
            <?php else: ?>
                <ul><?php foreach ($list['items'] as $item): ?><li><?= $escaper->escapeHtml($item['sku']) ?> × <?= $escaper->escapeHtml((string) $item['qty']) ?></li><?php endforeach; ?></ul>
            <?php endif; ?>
            <div class="actions-toolbar">
                <form action="<?= $escaper->escapeUrl($block->getUrl('b2brequisitionlists/list/addToCart')) ?>" method="post">
                    <?= $block->getBlockHtml('formkey') ?><input type="hidden" name="list_id" value="<?= (int) $list['entity_id'] ?>"/>
                    <button type="submit" class="action primary"><span><?= $escaper->escapeHtml(__('Add List to Cart')) ?></span></button>
                </form>
                <?php if ($canManage): ?>
                    <form action="<?= $escaper->escapeUrl($block->getUrl('b2brequisitionlists/list/delete')) ?>" method="post">
                        <?= $block->getBlockHtml('formkey') ?><input type="hidden" name="list_id" value="<?= (int) $list['entity_id'] ?>"/>
                        <button type="submit" class="action secondary"><span><?= $escaper->escapeHtml(__('Delete List')) ?></span></button>
                    </form>
                <?php endif; ?>
            </div>
        </section>
    <?php endforeach; ?>
    <?php if ($block->getPreviousPageUrl() || $block->getNextPageUrl()): ?>
        <div class="actions-toolbar">
            <?php if ($url = $block->getPreviousPageUrl()): ?><a class="action previous" href="<?= $escaper->escapeUrl($url) ?>"><?= $escaper->escapeHtml(__('Previous')) ?></a><?php endif; ?>
            <?php if ($url = $block->getNextPageUrl()): ?><a class="action next" href="<?= $escaper->escapeUrl($url) ?>"><?= $escaper->escapeHtml(__('Next')) ?></a><?php endif; ?>
        </div>
    <?php endif; ?>
    <?php if (!$lists): ?><div class="message info"><div><?= $escaper->escapeHtml(__('There are no requisition lists for your company yet.')) ?></div></div><?php endif; ?>
</div>
